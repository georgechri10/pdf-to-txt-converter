{
  "functions": {
    "api/ask.py": {
      "maxDuration": 30
    }
  },
  "builds": [
    {
      "src": "api/ask.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/ask",
      "dest": "/api/ask.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
